# Copy to .env for local work. `make` targets already set DESKFLOW_ENVIRONMENT=dev.
#
# environment defaults to "prod" ON PURPOSE. Two things are gated on it -- the
# JWT signing key and /auth/dev-sign-in, which mints a token for any user given
# only an email. A forgotten variable must fail closed, not open.
DESKFLOW_ENVIRONMENT=dev

# Required outside dev. At least 32 characters, and never the source default.
#   openssl rand -base64 48
# DESKFLOW_JWT_SECRET=

DESKFLOW_DATABASE_URL=postgresql+asyncpg://deskflow:deskflow@localhost:55432/deskflow

# Copy to .env for local work:  cp api/.env.example api/.env
#
# Settings FAIL CLOSED. DESKIFY_ENVIRONMENT defaults to "prod", because three
# things are gated on it -- the JWT signing key, the database credentials, and
# /auth/dev-sign-in, which mints a token for any user given only an email
# address. A forgotten variable must not hand out a published signing key, a
# published database password, and a live auth bypass.
#
# So dev is an explicit opt-in. The `make` targets, CI, and the test fixtures
# each set it; this file is for running things by hand.

DESKIFY_ENVIRONMENT=dev

# --------------------------------------------------------------------------
# The two values below are the DEVELOPMENT defaults, published in this
# repository. They work only while DESKIFY_ENVIRONMENT=dev. Outside dev the
# API refuses to start if either is still set to them.
# --------------------------------------------------------------------------

DESKIFY_DATABASE_URL=postgresql+asyncpg://deskify:deskify@localhost:55432/deskify
DESKIFY_JWT_SECRET=dev-only-not-a-real-secret

# --------------------------------------------------------------------------
# For staging and production, set both to real values. Generate them; do not
# invent them by hand.
#
#   DESKIFY_JWT_SECRET       >= 32 chars      openssl rand -base64 48
#   DESKIFY_DATABASE_URL     password >= 16 chars, not the username, and not
#                             a placeholder like "changeme" or "postgres"
#                                              openssl rand -base64 32
#
#   DESKIFY_ENVIRONMENT=prod
#   DESKIFY_JWT_SECRET=<48+ random chars>
#   DESKIFY_DATABASE_URL=postgresql+asyncpg://svc_deskify:<32+ random chars>@db.internal:5432/deskify
#
# In a real deployment these come from a managed secret store, not a file.
# --------------------------------------------------------------------------

# Access token lifetime in seconds. Short by design; refresh rotates.
DESKIFY_ACCESS_TOKEN_TTL_SECONDS=600

# --------------------------------------------------------------------------
# Mounts /auth/dev-sign-in outside dev. That endpoint issues a valid token for
# any known email with NO CREDENTIAL, so an API with this on is one anyone who
# can reach it can sign into as anyone in it.
#
# Off unless set. Only turn it on for a deployment whose database holds
# invented data, and unset it before real names go in.
#
# Use THIS, never DESKIFY_ENVIRONMENT=dev: the environment also selects the
# database connection options, and dev drops TLS and re-enables asyncpg's
# statement cache, which breaks a managed pooler.
# --------------------------------------------------------------------------
# DESKIFY_ALLOW_DEV_SIGN_IN=true
